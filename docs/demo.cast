[38.584, "o", "{\r\n  \"schemaVersion\": 1,\r\n  \"id\": \"demo-noodle-shop\",\r\n  \"isDemo\": true,\r\n  \"status\": \"demo\",\r\n  \"publicationApproved\": false,\r\n  \"lastConfirmedAt\": null,\r\n  \"categoryIds\": [],\r\n  \"entityType\": \"other\",\r\n  \"texts\": {\r\n    \"zh\": {\r\n      \"name\": \"虚构示例牛肉面馆\",\r\n      \"summary\": \"这是一家虚构的示例面馆。提供牛肉面和奶茶。\",\r\n      \"location\": \"虚构示例城区\",\r\n      \"address\": \"虚构示例路88号，仅用于演示，不是真实地址。\",\r\n      \"openingHours\": \"每天09:00至21:00营业。\",\r\n      \"mapUrl\": \"https://example.com/demo-map\",\r\n      \"services\": [\r\n        {\r\n          \"id\": \"demo-takeaway\",\r\n          \"text\": \"提供打包服务。\"\r\n        }\r\n      ],\r\n      \"products\": [\r\n        {\r\n          \"id\": \"demo-noodles\",\r\n          \"name\": \"示例牛肉面\",\r\n          \"specification\": \"每份500克。\",\r\n          \"supplyNote\": \"示例价格每份20元人民币，仅用于演示。\",\r\n          \"imageId\": \"demo-bowl\"\r\n        }\r\n      ]\r\n    },\r\n    \"mn\": {\r\n      \"mapUrl\": \"https://example.com/demo-map\",\r\n      \"products\": [\r\n        {\r\n          \"id\": \"demo-noodles\",\r\n          \"imageId\": \"demo-bowl\",\r\n          \"name\": \"Жишээ боовны талх\",\r\n          \"specification\": \"500 грамм тус бүр.\",\r\n          \"supplyNote\": \"Тодруулбал, нэг нь 20 юанийн үнэтэй бөгөөд зөвхөн илтгэл зориулалттай.\"\r\n        }\r\n      ],\r\n      \"services\": [\r\n        {\r\n          \"id\": \"demo-takeaway\",\r\n          \"text\": \"Уул уурхайн салбарын үйлчилгээ\"\r\n        }\r\n      ],\r\n      \"name\": \"Бодит бус үхрийн махны дэлгүүр\",\r\n      \"summary\": \"Энэ бол хуурамч ширэнгийн дэлгүүр юм.\",\r\n      \"location\": \"Бодит бус хот суурин газрын жишээ\",\r\n      \"address\": \"Жишээлбэл, 88 дугаар зам нь бодит хаяг биш, зөвхөн үзүүлбэрээр ашиглагдаж байна.\",\r\n      \"openingHours\": \"Өдөр бүр 09:00 цагаас 21:00 цаг хүртэл ажиллана.\"\r\n    }\r\n  },\r\n  \"translationStatus\": {\r\n    \"mn\": \"